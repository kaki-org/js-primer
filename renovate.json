{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automergeStrategy": "merge-commit",
  "packageRules": [
    {
      "description": "テスト用 npm パッケージの minor/patch は automerge",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "matchPackageNames": [
        "/^@types//"
      ]
    },
    {
      "description": "GitHub Actions は Dependabot で更新する",
      "matchManagers": [
        "github-actions"
      ],
      "enabled": false
    }
  ]
}
